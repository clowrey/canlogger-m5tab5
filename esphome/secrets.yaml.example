# Copy to secrets.yaml (git-ignored) and fill in.
wifi_ssid: "your-ssid"
wifi_password: "your-wifi-password"
# 32 random bytes, base64: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
api_encryption_key: "REPLACE_WITH_BASE64_KEY="
ota_password: "change-me"
# Login for the device page and the capture file downloads (/files, /dl)
web_server_username: "admin"
web_server_password: "change-me"
